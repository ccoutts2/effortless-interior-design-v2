generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scheme {
  id               Int               @id @default(autoincrement())
  name             String
  description      String
  stripePriceId    String?
  active           Boolean           @default(false)
  roomTypeName     String?
  features         String[]
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           Image[]
  orders           OrdersOnSchemes[]
  baskets          SchemesInBasket[]
  roomType         RoomType?         @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
}

model Image {
  id           Int       @id @default(autoincrement())
  url          String
  schemeId     Int
  schemeIndex  Int
  roomTypeName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roomType     RoomType? @relation(fields: [roomTypeName], references: [name], onDelete: Cascade)
  scheme       Scheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)
}

model RoomType {
  name      String   @id
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    Image[]
  schemes   Scheme[]
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  password      String?
  isActive      Boolean  @default(false)
  newsletterSub Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id               Int               @id @default(autoincrement())
  totalPrice       Int
  schemes          OrdersOnSchemes[]
  userId           Int
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  withConsultation Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model OrdersOnSchemes {
  schemeId  Int
  orderId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  scheme    Scheme   @relation(fields: [schemeId], references: [id])

  @@id([schemeId, orderId])
}

model Basket {
  id        Int               @id @default(autoincrement())
  sessionId String?           @unique
  session   Session?          @relation(fields: [sessionId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  schemes   SchemesInBasket[]
}

model SchemesInBasket {
  schemeId  Int
  basketId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheme    Scheme   @relation(fields: [schemeId], references: [id])
  basket    Basket   @relation(fields: [basketId], references: [id])

  @@id([schemeId, basketId])
}

model Session {
  id             String   @id
  secretHash     Bytes
  lastVerifiedAt DateTime
  createdAt      DateTime
  basket         Basket?
}
